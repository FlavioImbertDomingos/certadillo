# Copy to deploy/.env and replace every value. Generate keys with:
#   python -c "import secrets; print('cdl_' + secrets.token_urlsafe(32))"
CERTADILLO_KEY_PASSPHRASE=replace-me
CERTADILLO_BOOTSTRAP_ADMIN_KEY=replace-me
CERTADILLO_BOOTSTRAP_APPROVER_KEY=replace-me-with-a-different-key
CERTADILLO_BASE_URL=http://localhost:8080
CERTADILLO_ORG_NAME=Example Bank
POSTGRES_PASSWORD=replace-me
GRAFANA_ADMIN_PASSWORD=replace-me
# Zones for non-production names. A dev or test app whose whole scope is inside
# them is activated without a second person; every other onboarding needs one.
# CERTADILLO_DEV_DOMAINS=dev.bank.internal,test.bank.internal

# Audit shipping (docs/guide/25-audit-shipping.md). Every audit event is sent,
# signed, to each sink. Examples:
#   syslog+tls://siem.bank.internal:6514
#   splunk+https://splunk.bank.internal:8088
#   s3://pki-audit/certadillo/prod   (bucket created with Object Lock)
CERTADILLO_AUDIT_SHIP=
# env:NAME, file:/run/secrets/x or vault:path#field; never the token itself
CERTADILLO_AUDIT_SHIP_TOKEN_REF=
CERTADILLO_AUDIT_SHIP_CACERT=
CERTADILLO_AUDIT_SHIP_SPLUNK_INDEX=
